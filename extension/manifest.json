{
  "manifest_version": 3,
  "name": "Citeweave",
  "short_name": "Citeweave",
  "version": "0.2.0",
  "description": "Save the paper on any journal page to Citeweave, or open it on your citation map. Works with the free Citeweave desktop app.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Save to Citeweave",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Save the current paper to Citeweave" }
  }
}
